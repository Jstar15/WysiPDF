{
  "name": "wysipdf",
  "version": "0.1.4",
  "description": "Lightweight grid-based PDF template designer built on pdfMake",
  "author": "Jstar",
  "license": "MIT",
  "main": "wysipdf.bundle.js",
  "module": "wysipdf.node.esm.mjs",
  "browser": "wysipdf.bundle.js",
  "type": "module",
  "files": [
    "wysipdf.bundle.js",
    "wysipdf.node.esm.mjs",
    "readme/**",
    "readme/images/**"
  ],
  "scripts": {
    "prepublishOnly": "echo 'Ensure both bundles exist before publishing'"
  },
  "keywords": [
    "pdf",
    "pdfmake",
    "wysiwyg",
    "grid",
    "template",
    "designer",
    "node",
    "browser",
    "esm"
  ],
  "exports": {
    ".": {
      "import": "./wysipdf.node.esm.mjs",
      "require": "./wysipdf.bundle.js",
      "browser": "./wysipdf.bundle.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jstar15/WysiPDF.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "pdfmake": "^0.2.20",
    "echarts": "^6.0.0",
    "qrcode": "^1.5.4",
    "jsbarcode": "^3.12.1"
  }
}
